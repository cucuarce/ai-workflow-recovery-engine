# Plantilla. Copiar a .env (ignorado por git) y reemplazar CADA valor por uno aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Los tokens deben tener al menos 32 caracteres y ser distintos entre sí.

# Bearer para /operations* (credencial "Recovery Engine API" en n8n, Workflow 1).
ENGINE_API_TOKEN=replace-me
# Bearer para /worker/run, planes de fallos y /simulator/* (credencial "Recovery Engine Admin",
# Workflow 2 y operador local). NUNCA se usa en el Workflow 1.
ADMIN_API_TOKEN=replace-me
# Secreto que debe enviar quien llama al webhook de n8n (header X-Recovery-Webhook-Token).
WEBHOOK_SECRET=replace-me
# Clave con la que n8n cifra sus credenciales. Si se pierde, hay que recrearlas.
N8N_ENCRYPTION_KEY=replace-me

# Solo demo. Poner en false para levantar el mismo stack sin inyección de fallos.
FAULT_INJECTION_ENABLED=true
