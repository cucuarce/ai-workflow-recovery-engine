{
  "id": "RecRecoveryWf001",
  "name": "Recovery Engine - 02 Recovery",
  "active": false,
  "nodes": [
    {
      "id": "5e2a9c41-7b3d-4f10-8c6e-2a9d4b7e1c01",
      "name": "Cada 30 segundos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "5e2a9c41-7b3d-4f10-8c6e-2a9d4b7e1c02",
      "name": "Ejecutar worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300],
      "parameters": {
        "method": "POST",
        "url": "http://engine:8000/worker/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "max_operations", "value": "25" },
            { "name": "worker_id", "value": "n8n-recovery" }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "RecEngAdmCred001",
          "name": "Recovery Engine Admin"
        }
      }
    },
    {
      "id": "5e2a9c41-7b3d-4f10-8c6e-2a9d4b7e1c03",
      "name": "¿Requiere atención?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b8e2d1ef-0001-4000-8000-000000000001",
              "leftValue": "={{ ($json.items ?? []).some(i => i.final_status === 'dead_letter' || i.action === 'lease_lost' || i.action === 'error_left_for_lease_expiry') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "5e2a9c41-7b3d-4f10-8c6e-2a9d4b7e1c04",
      "name": "Marcar ejecución con error",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [720, 200],
      "parameters": {
        "errorMessage": "={{ 'Operaciones que requieren atención: ' + $json.items.filter(i => i.final_status === 'dead_letter' || i.action === 'lease_lost' || i.action === 'error_left_for_lease_expiry').map(i => i.operation_id + ' (' + (i.final_status ?? i.action) + ')').join(', ') }}"
      }
    },
    {
      "id": "5e2a9c41-7b3d-4f10-8c6e-2a9d4b7e1c05",
      "name": "Sin novedades",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 400],
      "parameters": {}
    }
  ],
  "connections": {
    "Cada 30 segundos": {
      "main": [[{ "node": "Ejecutar worker", "type": "main", "index": 0 }]]
    },
    "Ejecutar worker": {
      "main": [[{ "node": "¿Requiere atención?", "type": "main", "index": 0 }]]
    },
    "¿Requiere atención?": {
      "main": [
        [{ "node": "Marcar ejecución con error", "type": "main", "index": 0 }],
        [{ "node": "Sin novedades", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": true
  },
  "tags": []
}
